PORT=3001

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenRouter (LLM)
OPENROUTER_API_KEY=sk-or-...
LLM_MODEL=qwen/qwen-2.5-72b-instruct

# Embeddings (OpenAI-compatible /embeddings endpoint)
#
# Option A — OpenAI directly:
# EMBEDDING_API_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
#
# Option B — same OpenRouter key as LLM (model MUST appear under OpenRouter "embeddings" models):
EMBEDDING_API_KEY=sk-or-same-as-openrouter
EMBEDDING_API_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small

# RAG retrieval
# Cosine similarity threshold (0..1) used when querying match_documents RPC.
# Lower = recall over precision. Empirical sweet spot for text-embedding-3-small ≈ 0.3.
RAG_MATCH_THRESHOLD=0.3

# Telegram bot (optional — disabled by default)
# Set TELEGRAM_ENABLED=true to launch the bot alongside the HTTP server.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=                       # required when enabled (from @BotFather)
TELEGRAM_OWNER_USER_ID=                   # required when enabled — auth.users.id whose KB the bot serves
TELEGRAM_MODE=polling                     # polling (dev) | webhook (prod)
TELEGRAM_WEBHOOK_URL=                     # required for webhook mode, full https URL
TELEGRAM_WEBHOOK_SECRET=                  # required for webhook mode, random string (≥32 chars)
TELEGRAM_ALLOWED_USERS=                   # optional whitelist of TG user IDs (comma-separated). Empty = open to all.
TELEGRAM_RATE_LIMIT_PER_MIN=3             # in-memory rate limit per TG user (per minute)
TELEGRAM_RATE_LIMIT_PER_DAY=50            # in-memory rate limit per TG user (per day)
TELEGRAM_FREE_QUOTA=5                     # initial pay-per-use quota for new TG users
